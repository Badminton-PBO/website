---
/**
 * Lege pagina waarin Decap CMS opstart. De config komt uit src/lib/cms.ts.
 * Decap staat vast op een versie; bij een update eerst lokaal testen en de `integrity` hieronder vervangen
 * (unpkg toont ze bij decap-cms.js op https://unpkg.com/decap-cms@<versie>/dist/?meta).
 * Voorlopig 3.16.2: in 3.16.3 tot en met 3.17.3 blijft de miniatuur van een afbeeldingsveld leeg bij een
 * bestaande waarde (bestuursfoto's, sponsorlogo's, affiche PK). Gekend bij Decap (issue #8055), opgelost
 * in PR #8057 (17 november 2026): updaten kan vanaf de eerste versie na 3.17.3.
 */
import { u } from '../lib/url';
import { alleToernooien } from '../lib/jeugdcup';
import { lang } from '../lib/datum';

interface Props {
  config: string;
  title: string;
}

const { config, title } = Astro.props;

/** Controle dat de browser precies deze versie van Decap uitvoert: bij een update van de versie mee aanpassen. */
const DECAP = {
  src: 'https://unpkg.com/decap-cms@3.16.2/dist/decap-cms.js',
  integrity: 'sha384-tbnFsiSBvMm2vOLu70Mx7HlnMj6kXxR0Tdo0USlY9564mb1AyMnIdCjOZ738PWPr',
};
// Namen van de haltes voor de lijst met rankings en het voorbeeld (src/scripts/admin-toernooien.ts).
const toernooien = Object.fromEntries((await alleToernooien()).map((t) => [t.id, `${t.club}, ${lang(t.datum)}`]));
---

<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link href={u(config)} type="text/yaml" rel="cms-config-url" />
    <style is:inline>
      /* Een geplakte stand telt tientallen regels: het veld scrolt, zodat de tien standen van een toernooi overzichtelijk onder elkaar blijven. */
      textarea {
        max-height: 15em;
        overflow-y: auto !important;
      }
    </style>
  </head>
  <body>
    <script is:inline define:vars={{ toernooien }}>
      window.pboToernooien = toernooien;
    </script>
    <!-- Met integrity weigert de browser het script als unpkg iets anders zou leveren: het beheer werkt met logintokens. -->
    <script is:inline src={DECAP.src} integrity={DECAP.integrity} crossorigin="anonymous"></script>
    <script>
      import '../scripts/admin-toernooien';
      import '../scripts/admin-preview';
      import '../scripts/admin-plakken';
      import '../scripts/admin-controle';
      import '../scripts/admin-status';
    </script>
  </body>
</html>
